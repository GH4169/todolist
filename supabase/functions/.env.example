# Comma-separated browser origins allowed to call the Edge Functions.
ALLOWED_ORIGINS=https://gh4169.github.io,http://localhost:8000

# OpenAI-compatible API root. Keep /v1 in the URL.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional comma-separated exact hostnames or suffixes such as .example.com.
# Leave empty to allow public HTTPS provider hosts after private-host blocking.
AI_PROVIDER_ALLOWED_HOSTS=

# Generate with: openssl rand -base64 32
AI_CREDENTIAL_MASTER_KEY=

# Override at deploy time when the preferred model changes.
OPENAI_MODEL=gpt-5.6
